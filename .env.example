# ==============================================================================
# Stackfyra Standalone NestJS Backend Environment Configuration
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/stackfyra

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Resend Transactional Email & Outbox Configuration
RESEND_API_KEY=re_123456789_placeholder_key
RESEND_FROM_EMAIL=leads@stackfyra.com
RESEND_TO_EMAIL=admin@stackfyra.com
EMAIL_FROM=noreply@stackfyra.com
EMAIL_REPLY_TO=info@stackfyra.com
EMAIL_ENCRYPTION_KEY=replace_with_a_secure_32_byte_secret_or_use_jwt_secret
RESEND_WEBHOOK_SECRET=whsec_placeholder_secret

# Optional Master Administrator Bootstrap Credentials
ADMIN_NAME="Stackfyra Master Admin"
ADMIN_EMAIL=admin@stackfyra.com
ADMIN_PASSWORD=AdminPass123!

# Firebase Cloud Messaging (FCM) Admin SDK Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Meta Facebook & Instagram Lead Ads Integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=create_a_strong_random_verify_token_here
META_REDIRECT_URI=http://localhost:4000/api/meta/oauth/callback
META_TOKEN_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_or_secret
META_SYNC_INTERVAL_MINUTES=60
CRON_SECRET=create_a_secret_for_scheduled_reconciliation_jobs

# Optional Direct Meta Page Access Token (Can also be connected via Admin UI)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_NAME="Stackfyra Technologies"
